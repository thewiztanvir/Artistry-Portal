# ─────────────────────────────────────────────────────────────
#  Artistry Accessories & Packaging — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependencies ──────────────────────────────────────────────
node_modules/
node_modules
**/node_modules/
**/node_modules/**
.pnp
.pnp.js
.yarn/install-state.gz

# ── Next.js build & static export ─────────────────────────────
.next/
.next
**/.next/
out/
out
**/out/
build/
dist/
coverage/
.nyc_output/

# ── TypeScript & Next generated files ─────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Environment & local secrets ───────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# ── Design source files & Master vectors ──────────────────────
# Only exported .svg and web graphics should be in git
*.ai
**/*.ai
*.eps
**/*.eps
*.psd
**/*.psd

# ── PDFs and Documentations ───────────────────────────────────
*.pdf
**/*.pdf
artistry-brand-style-guide.pdf
public/artistry-logo/*.pdf

# ── Internal PRD & Requirements Documents ─────────────────────
*PRD*
*PRD*.md
Artistry Accessories & Packaging Website PRD.md

# ── Logs & Debug output ───────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ── Tool & deployment caches ──────────────────────────────────
.turbo/
.vercel/
.netlify/
.cache/
.parcel-cache/

# ── Testing artifacts ─────────────────────────────────────────
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ── Private keys & certificates ───────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── Operating System files ────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ── IDE & Editor files ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.iml
*.iws
*.swp
*.swo
*.code-workspace

# ── Miscellaneous ─────────────────────────────────────────────
*.tgz
*.tar.gz
.eslintcache
.stylelintcache
